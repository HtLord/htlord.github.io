---
import '@styles/tailwind.css';

const { title } = Astro.props;
---
<div class="section">
    <h3 class="eyebrow">
        {title}
    </h3>
    <slot />
</div>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0;
    padding: 0 0 var(--space-2);
    border-bottom: 1px solid var(--line);
  }

  @media print {
    .eyebrow {
      color: #333;
      border-bottom-color: #999;
    }
  }
</style>
