---
import '@styles/tailwind.css';

const { data: resumeData } = Astro.props;
const educations = resumeData.educations;
---
<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0;
  }
  .degree {
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 700;
    color: var(--ink);
    margin: 0.2em 0 0;
  }
  .head {
    border-bottom: 1px solid var(--line);
    padding-bottom: var(--space-2);
  }
  .meta {
    font-family: var(--font-mono);
    font-size: 12.5px;
  }
  .meta .university {
    color: var(--ink);
    font-weight: 600;
  }
  .meta .period {
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }
  .achievement {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
  }

  @media print {
    .head {
      border-bottom-color: #999;
    }
    .eyebrow {
      color: #333;
    }
    .degree,
    .meta .university {
      color: #000;
    }
    .meta .period,
    .achievement {
      color: #333;
    }
  }
</style>
{
    educations.map((edu: any) => {
        return (
            <div class="px-4 mb-8">
              <div class="
                head
                mb-2
                grid grid-cols-12
              ">
                <div class="col-span-8 row-span-2">
                  <h3 class="eyebrow">
                      Education
                  </h3>
                  <h6 class="degree">
                      {edu.degree}
                  </h6>
                </div>
                <div class="meta col-span-4 grid grid-rows-2">
                  <div class="university"> {edu.university}</div>
                  <div class="period">{edu.period}</div>
                </div>
              </div>
              <div id="achievement" class="achievement">
                Built a prototype iris recognition system on Android, integrating image preprocessing, feature extraction, and matching algorithms for biometric authentication.
              </div>
            </div>
        )
    })
}
