---
import '@styles/tailwind.css';

const { data: resumeData } = Astro.props;
const contacts = resumeData.you.contacts;
---
<div class="contacts flex flex-col md:col-span-4 md:items-end print:col-span-4 print:items-end">
    {
        contacts?.map((contact: any) => {
           return (
               <div class="flex">
                 <a href=`mailto:${contact.value}`>{contact.value}</a>
               </div>
           );
        })
    }
</div>

<style>
  .contacts {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    justify-content: center;
    gap: 2px;
  }
  .contacts a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .contacts a:hover {
    color: var(--twin-ink);
    border-bottom-color: var(--twin-line);
  }

  @media print {
    .contacts {
      color: #000;
    }
    .contacts a {
      color: #000;
    }
  }
</style>
