---
import '@styles/tailwind.css';
import { getEntry } from "astro:content";
import Reference from "./Reference.astro";

const resumeData =  await getEntry('resume', 'index');
const experiences = resumeData.data.experiences;
---
<style>
@media print {
  li {
    page-break-inside: avoid;
    break-inside: avoid;
  }
}
</style>
<div class="px-4">
    {
        experiences?.map((exp: any, index: number) => {
            return (
                <div class="mb-8">
                  <div class="
                    mb-2
                    grid grid-cols-12
                    border-b-2 border-black border-dotted
                  ">
                    <h3 class="col-span-8">
                        {exp.title}
                    </h3>
                    <div class="col-span-4 grid grid-rows-2">
                      <div>{exp.name}</div>
                      <div>{exp.period}</div>
                    </div>
                  </div>
                  <div id="achievement">
                    {exp.projects ? (
                      <ul class="list-disc pl-8 mb-2">
                        {exp.projects.map((proj: any) => (
                          <li class="mb-1">
                            <span class="font-semibold">{proj.name}</span>
                            {proj.stack && (
                              <span class="text-gray-500"> - {proj.stack.join(' / ')}</span>
                            )}
                            {proj.points ? (
                              <ul class="list-disc pl-4">
                                {proj.points.map((pt: string) => (
                                  <li>{pt}</li>
                                ))}
                              </ul>
                            ) : (
                              <div class="pr-2">{proj.description}</div>
                            )}
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <ul class="list-disc pl-8 mb-2">
                        {exp.achievements?.map((arch: any) => (
                          <li>
                            <span class="flex">
                              <div class="pr-2">{arch.description}</div>
                              {arch.references?.map((reference: string, index: any) => (
                                <Reference value={index+1} url={reference}/>
                              ))}
                            </span>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </div>
            )
        })
    }
</div>
