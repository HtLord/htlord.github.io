---
import '@styles/tailwind.css';
import Section from "./Section.astro";
import TechStack from "./TechStack.astro";

const { data: resumeData } = Astro.props;
const skills = resumeData.skills;
---
<Section title="Skill">
  <div class="chips flex flex-wrap gap-2 pt-3">
    {skills?.map((skill: any) => <TechStack value={skill}/>)}
  </div>
</Section>
