---
import '@styles/tailwind.css';

const { value } = Astro.props
---
<span class="chip">
    {value}
</span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    margin: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--twin-ink);
    background: var(--twin-tint);
    border: 1px solid var(--twin-line);
    border-radius: var(--radius-full);
    padding: 4px 11px;
    line-height: 1.4;
  }

  @media print {
    .chip {
      color: #000;
      background: #fff;
      border-color: #999;
    }
  }
</style>
