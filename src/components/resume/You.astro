---
import '@styles/tailwind.css';
import Contacts from "./Contacts.astro";

const { data: resumeData } = Astro.props;
---
<div
    class="
    p-4
    grid-cols-12
    md:grid
    print:grid
    "
>
  <div
      class="
      flex flex-col
      md:col-span-8
      print:col-span-8 print:justify-self-end
      "
  >
    <h3>{ resumeData.you.name }</h3>
    <h4 class="text-gray">{ resumeData.you.title }</h4>
  </div>
  <Contacts data={resumeData} />
</div>
