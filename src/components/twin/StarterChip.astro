---
/**
 * StarterChip — a selectable starter question. Steel (--visitor) on
 * hover/selected: chips are how the visitor speaks before they've typed
 * anything.
 */
interface Props {
  selected?: boolean;
}

const { selected = false } = Astro.props;
---

<button type="button" class:list={['chip', { on: selected }]} aria-pressed={selected}>
  <slot />
</button>

<style>
  .chip {
    font-family: var(--font-sans);
    font-size: 13.5px;
    color: var(--muted);
    cursor: pointer;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-full);
    padding: 7px 13px;
    transition:
      transform 0.12s ease,
      border-color 0.12s ease,
      color 0.12s ease;
  }
  .chip:hover {
    color: var(--ink);
    border-color: var(--visitor-line);
    transform: translateY(-1px);
  }
  .chip.on {
    color: var(--visitor-ink);
    border-color: var(--visitor-line);
    background: var(--visitor-tint);
  }
</style>
