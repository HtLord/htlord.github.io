---
/**
 * InstrumentBar — the site's top nav / "instrument panel".
 *
 * Carries the twin/visitor colour split: the live-status dot is a
 * `--twin` (yellow) pulse — it's the twin's own live signal. Name is set
 * in the twin's voice (serif) beside a mono system subtitle; nav links and
 * the status pill are mono, matching the "system instrumentation" type role.
 */
interface NavLink {
  href: string;
  label: string;
}

interface Props {
  nameZh?: string;
  nameEn?: string;
  status?: string;
  live?: boolean;
  links?: NavLink[];
  current?: string;
}

const {
  nameZh = '黃偉程',
  nameEn = 'htlord · digital twin',
  status = 'online',
  live = true,
  links = [
    { href: '/', label: 'Twin' },
    { href: '/about', label: 'About' },
    { href: '/blog', label: 'Writing' },
    { href: 'https://github.com/htlord', label: 'GitHub' },
  ],
  current = '/',
} = Astro.props;

// Mobile dropdown trigger shows the current tab's own label (falls back to
// "Menu" if `current` doesn't match any link's href).
const currentLabel = links.find((link) => link.href === current)?.label ?? 'Menu';
---

<header class="bar">
  <div class="brand">
    <span class="zh">{nameZh}</span>
    <span class="en">{nameEn}</span>
  </div>
  <span class="status">
    <span class:list={['dot', { live }]}></span>
    {status}
  </span>
  <nav>
    {links.map((link) => (
      <a href={link.href} class:list={{ on: link.href === current }}>{link.label}</a>
    ))}
  </nav>
  <!--
    Mobile-only dropdown (≤560px, see media query below). Desktop hides this
    entirely and keeps the flat <nav> above unchanged. CSS-only via
    <details>/<summary> so it works with no JS; the inline script below is
    a pure enhancement (outside-tap/Escape close + explicit aria-expanded).
  -->
  <details class="nav-menu">
    <summary class="nav-menu-trigger">
      <span class="nav-menu-label">{currentLabel}</span>
      <span class="nav-menu-caret" aria-hidden="true">▾</span>
    </summary>
    <nav class="nav-menu-panel">
      {links.map((link) => (
        <a href={link.href} class:list={{ on: link.href === current }}>{link.label}</a>
      ))}
    </nav>
  </details>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) clamp(var(--space-4), 4vw, var(--space-8));
    background: color-mix(in srgb, var(--ground) 84%, transparent);
    backdrop-filter: saturate(160%) blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    min-width: 0;
  }
  .brand .zh {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--ink);
  }
  .brand .en {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
    padding: 4px 9px;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    background: var(--surface);
    white-space: nowrap;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--twin);
  }
  @media (prefers-reduced-motion: no-preference) {
    .dot.live {
      animation: instrument-pulse 2.6s ease-out infinite;
    }
  }
  @keyframes instrument-pulse {
    0% {
      box-shadow: 0 0 0 0 var(--twin-tint);
    }
    70% {
      box-shadow: 0 0 0 6px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }
  nav a {
    font-family: var(--font-mono);
    font-size: 12.5px;
    text-decoration: none;
    color: var(--muted);
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    letter-spacing: 0.01em;
  }
  nav a:hover {
    color: var(--ink);
    background: var(--surface-2);
  }
  nav a.on {
    color: var(--twin-ink);
    background: var(--twin-tint);
  }

  /* Mobile dropdown trigger — hidden entirely on desktop so the flat <nav>
     above renders exactly as before. */
  .nav-menu {
    display: none;
  }

  @media (max-width: 560px) {
    /* Hide the flat row (but not the dropdown's own nested <nav> panel)
       and show the dropdown trigger in its place. */
    nav:not(.nav-menu-panel) {
      display: none;
    }

    .nav-menu {
      display: block;
      position: relative;
      margin-left: auto;
    }

    .nav-menu-trigger {
      display: flex;
      align-items: center;
      gap: 4px;
      font-family: var(--font-mono);
      font-size: 12.5px;
      letter-spacing: 0.01em;
      color: var(--twin-ink);
      background: var(--twin-tint);
      padding: 6px 10px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      list-style: none;
      user-select: none;
    }
    .nav-menu-trigger::-webkit-details-marker {
      display: none;
    }
    .nav-menu-trigger::marker {
      content: '';
    }

    .nav-menu-caret {
      font-size: 10px;
      transform-origin: 50% 45%;
    }
    .nav-menu[open] .nav-menu-caret {
      transform: rotate(180deg);
    }
    @media (prefers-reduced-motion: no-preference) {
      .nav-menu-caret {
        transition: transform 0.15s ease;
      }
    }

    .nav-menu-panel {
      position: absolute;
      top: calc(100% + 6px);
      right: 0;
      min-width: 150px;
      margin: 0;
      padding: 6px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      box-shadow:
        0 1px 2px rgba(0, 0, 0, 0.06),
        0 14px 34px -22px rgba(0, 0, 0, 0.34);
    }
    /* Only declare the open layout — when closed, the UA stylesheet already
       hides non-summary <details> children, so we don't fight it here. */
    .nav-menu[open] .nav-menu-panel {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
    }
    .nav-menu-panel a {
      display: block;
      width: 100%;
      padding: 9px 10px;
    }
  }
</style>

<script>
  // Pure enhancement over the native <details>/<summary> disclosure: closing
  // on outside-tap/Escape, and mirroring aria-expanded explicitly. None of
  // this is required for the menu to work — with JS disabled it still opens
  // and closes natively, and links still navigate normally.
  document.querySelectorAll('.nav-menu').forEach((menu) => {
    if (!(menu instanceof HTMLDetailsElement)) return;
    const summary = menu.querySelector('summary');
    if (!summary) return;

    const syncExpanded = () => {
      summary.setAttribute('aria-expanded', String(menu.open));
    };
    syncExpanded();
    menu.addEventListener('toggle', syncExpanded);

    document.addEventListener('click', (event) => {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) {
        menu.open = false;
      }
    });

    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        summary.focus();
      }
    });
  });
</script>
