---
/**
 * index.astro — the digital-twin homepage.
 *
 * Chat-first landing page: InstrumentBar + hero, a conversation thread
 * seeded with a static greeting (so the page has real content before JS
 * hydrates), starter chips, and the composer. The static shell below is
 * server-rendered and paints immediately; src/scripts/twin-chat.ts hydrates
 * it into a live chat island (see the <template> blocks near the bottom —
 * those are cloned by that script, never shown directly).
 *
 * Deliberately does NOT use BaseLayout/BaseHead (src/components/BaseHead.astro):
 * that pulls in src/styles/global.css, whose legacy `:root { --accent: ... }`
 * block would clobber the design-system tokens in src/styles/tokens.css
 * (same variable name, both unscoped, global.css would win by source order).
 * Importing tokens.css directly — the same approach src/pages/_kit.astro
 * uses — keeps the twin/visitor colour system intact.
 */
import '../styles/tokens.css';
import { SITE } from '../consts';
import InstrumentBar from '../components/twin/InstrumentBar.astro';
import TwinBubble from '../components/twin/TwinBubble.astro';
import VisitorBubble from '../components/twin/VisitorBubble.astro';
import StarterChip from '../components/twin/StarterChip.astro';
import Composer from '../components/twin/Composer.astro';
import Button from '../components/twin/Button.astro';
import CitedFact from '../components/twin/CitedFact.astro';

const title = '黃偉程 · htlord — digital twin';
const description =
  'Ask my digital twin anything — a chat-first portfolio grounded in real work history, with cited facts and honest refusals instead of guesses.';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Starter chips: bilingual, seeded from real questions (see CLAUDE.md for
// the underlying facts). `en` is the rendered default; src/scripts/twin-chat.ts
// swaps to `zh` client-side when the browser's language is Chinese. Whichever
// text is on-screen at click time is exactly what gets sent as the question.
const STARTER_CHIPS = [
  { en: 'What did you do at Dentall?', zh: '在 Dentall 到底做了什麼？' },
  { en: "What's not on your résumé?", zh: '履歷上沒寫的是什麼？' },
  { en: 'Did you lead a 6-person team?', zh: '你真的帶過六人團隊嗎？' },
  { en: '用中文聊技術債', zh: '用中文聊技術債' },
] as const;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/png" href={SITE.favicon} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <InstrumentBar current="/" />

    <main class="stage">
      <section class="hero">
        <h1>Ask my digital twin anything</h1>
        <p class="subline">
          A chat-first portfolio — grounded in real work history, cited facts, and honest
          &ldquo;I don't know&rdquo;s instead of guesses.
        </p>
      </section>

      <section class="thread" id="thread" aria-live="polite" aria-relevant="additions">
        <TwinBubble label="digital twin" live>
          Hi — I'm htlord's digital twin. Ask about the engineering work, how I think about
          tradeoffs, or something the résumé leaves out.
        </TwinBubble>
      </section>

      <section class="chips" id="starterChips" aria-label="starter questions">
        {STARTER_CHIPS.map((c) => (
          <div class="chip-wrap" data-en={c.en} data-zh={c.zh}>
            <StarterChip>{c.en}</StarterChip>
          </div>
        ))}
      </section>

      <section class="composer-wrap">
        <Composer />
        <p class="honesty-note">
          Answers are grounded in real work history — when something isn't documented, the twin
          says so instead of guessing.
        </p>
      </section>

      <p class="more-link">
        Prefer the traditional version? <a href="/about">About &amp; résumé →</a>
      </p>
    </main>

    <!--
      Hidden templates, cloned by src/scripts/twin-chat.ts. Never rendered
      directly — `<template>` content is inert until `.content` is cloned.
      Building these from the real Astro components (rather than duplicating
      markup/CSS in the client script) means every cloned bubble gets the
      exact same styling as the static ones above, for free.
    -->
    <template id="tpl-visitor-bubble">
      <VisitorBubble><span class="msg-text"></span></VisitorBubble>
    </template>

    <template id="tpl-thinking-bubble">
      <TwinBubble label="digital twin" live>
        <span class="thinking">
          <span class="phase-label">reviewing the question…</span>
          <span class="typing-dots" aria-hidden="true"><span></span><span></span><span></span></span>
        </span>
      </TwinBubble>
    </template>

    <!--
      One bubble shape covers done/refused/error: the flag spans and retry
      button start hidden, and twin-chat.ts reveals only the ones a given
      turn needs. `sources={['__pending__']}` forces TwinBubble's provenance
      markup to exist statically so the script can populate or hide it
      rather than trying to inject new elements that wouldn't inherit
      TwinBubble's scoped styling.
    -->
    <template id="tpl-answer-bubble">
      <TwinBubble label="digital twin" sources={['__pending__']}>
        <span class="state-flag flag-refused" hidden>◇ off-topic</span>
        <span class="state-flag flag-error" hidden>⚠ error</span>
        <span class="msg-text"></span><span class="cursor" aria-hidden="true"></span>
        <span class="retry-wrap" hidden></span>
      </TwinBubble>
    </template>

    <template id="tpl-retry-button">
      <Button variant="secondary" type="button">Retry</Button>
    </template>

    <!-- Harvests CitedFact's scoped-style attribute — see twin-chat.ts. -->
    <div id="cite-cid-harvest" hidden aria-hidden="true"><CitedFact source="harvest">x</CitedFact></div>

    <style>
      body {
        margin: 0;
        background: var(--ground);
        color: var(--ink);
        font-family: var(--font-sans);
        line-height: 1.6;
      }

      .stage {
        max-width: 760px;
        margin: 0 auto;
        padding: 0 clamp(var(--space-4), 4vw, var(--space-6)) var(--space-8);
      }

      .hero {
        padding: var(--space-7) 0 var(--space-6);
      }
      .hero h1 {
        font-family: var(--font-serif);
        font-size: clamp(28px, 5vw, 42px);
        line-height: 1.15;
        margin: 0 0 var(--space-3);
        color: var(--ink);
      }
      .hero .subline {
        font-family: var(--font-sans);
        font-size: 16px;
        color: var(--muted);
        max-width: 58ch;
        margin: 0;
      }

      .thread {
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
        margin-bottom: var(--space-6);
      }

      .chips {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin-bottom: var(--space-5);
        transition: opacity 0.15s ease;
      }
      .chips.busy {
        opacity: 0.5;
        pointer-events: none;
      }
      /* Keeps the extra wrapper div out of the flex box model so chips lay
         out exactly as they do in the component kit. */
      .chip-wrap {
        display: contents;
      }

      .composer-wrap {
        position: sticky;
        bottom: 0;
        padding: var(--space-3) 0 var(--space-2);
        background: linear-gradient(to top, var(--ground) 65%, transparent);
        transition: opacity 0.15s ease;
      }
      .composer-wrap.busy {
        opacity: 0.75;
      }

      .honesty-note {
        font-family: var(--font-mono);
        font-size: 11.5px;
        color: var(--faint);
        text-align: center;
        margin: var(--space-2) 0 0;
      }

      .more-link {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--faint);
        text-align: center;
        margin: var(--space-3) 0 0;
      }
      .more-link a {
        color: var(--visitor-ink);
      }

      /* ---- dynamic thread content (cloned from the templates above) ---- */

      .thinking {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-mono);
        font-size: 12.5px;
        color: var(--faint);
      }
      .typing-dots {
        display: inline-flex;
        gap: 3px;
      }
      .typing-dots span {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--faint);
        opacity: 0.5;
      }
      @media (prefers-reduced-motion: no-preference) {
        .typing-dots span {
          animation: twin-typing 1.1s ease-in-out infinite;
        }
        .typing-dots span:nth-child(2) {
          animation-delay: 0.15s;
        }
        .typing-dots span:nth-child(3) {
          animation-delay: 0.3s;
        }
      }
      @keyframes twin-typing {
        0%,
        80%,
        100% {
          opacity: 0.35;
          transform: translateY(0);
        }
        40% {
          opacity: 1;
          transform: translateY(-2px);
        }
      }

      .cursor {
        display: inline-block;
        width: 2px;
        height: 1em;
        background: var(--twin-ink);
        margin-left: 2px;
        vertical-align: -0.15em;
      }
      @media (prefers-reduced-motion: no-preference) {
        .cursor {
          animation: twin-caret 1s steps(1) infinite;
        }
      }
      @keyframes twin-caret {
        50% {
          opacity: 0;
        }
      }

      .state-flag {
        display: inline-flex;
        align-items: center;
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--faint);
        border: 1px solid var(--line-strong);
        border-radius: var(--radius-sm);
        padding: 2px 7px;
        margin-right: 8px;
        vertical-align: middle;
      }
      .state-flag.flag-error {
        color: #b03a2e;
        border-color: rgba(176, 58, 46, 0.45);
      }
      @media (prefers-color-scheme: dark) {
        .state-flag.flag-error {
          color: #e07a67;
          border-color: rgba(224, 122, 103, 0.45);
        }
      }
      :root[data-theme='dark'] .state-flag.flag-error {
        color: #e07a67;
        border-color: rgba(224, 122, 103, 0.45);
      }
      :root[data-theme='light'] .state-flag.flag-error {
        color: #b03a2e;
        border-color: rgba(176, 58, 46, 0.45);
      }

      .retry-wrap {
        display: block;
        margin-top: var(--space-3);
      }

      @media (max-width: 560px) {
        .hero h1 {
          font-size: 26px;
        }
      }
    </style>

    <script>
      import '../scripts/twin-chat';
    </script>
  </body>
</html>
